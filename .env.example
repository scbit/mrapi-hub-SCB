# Core tenant
MRAPI_TENANT_ID=scb
MRAPI_CRM_DB=bscrmscb
MRAPI_INBOX_DB=bsscb
MRAPI_FILES_BUCKET=
MRAPI_SESSION_SECRET=
MRAPI_PUBLIC_BASE_URL=

# Branding overrides (optional: SCB and artec have presets)
MRAPI_BRAND_NAME=
MRAPI_BRAND_SHORT_NAME=
MRAPI_BRAND_SUBTITLE=
MRAPI_BRAND_LOGO_URL=
MRAPI_PRIMARY_COLOR=
MRAPI_PRIMARY_DARK_COLOR=
MRAPI_ACCENT_COLOR=

# WhatsApp / Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Dialogflow / Conversational Agent (optional)
DF_PROJECT_ID=
DF_AGENT_ID=
DF_LOCATION=global
DF_LANGUAGE_CODE=es

# Desk (optional)
MRAPI_DESK_DB=
MRAPI_DESK_BASE_URL=
# Same exact secret must also be configured in the Desk Cloud Run
DESK_SSO_SECRET=
DESK_SSO_TTL_SECONDS=60

# Conversational Agents / Dialogflow CX (optional per tenant)
DF_PROJECT_ID=
DF_AGENT_ID=
DF_LOCATION=us-central1
DF_LANGUAGE_CODE=es

# MRAPI Gateway (Meta WhatsApp directo)
MRAPI_GATEWAY_URL=https://mrapi-gateway-604957912671.us-central1.run.app
MRAPI_GATEWAY_API_KEY=
MRAPI_GATEWAY_SECRET=
MRAPI_GATEWAY_TENANT_ID=

# Recovery automation engine (Cloud Scheduler). If omitted, MRAPI_GATEWAY_SECRET is accepted as fallback.
MRAPI_RECOVERY_ENGINE_SECRET=

# MRAPI-WP — alerta CRM cuando un trato entra a Cotizado para enviar
MRAPI_WHATSAPP_BASE_URL=https://mrapi-wp-604957912671.us-central1.run.app
MRAPI_WHATSAPP_SYSTEM_TOKEN=
